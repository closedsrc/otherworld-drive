<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark is the app's own progress ring: a ring drawn three-quarters round with
  a head floating in the break. It reads as "something is steadily moving into
  place", which is what this app does, and it uses no cloud, no arrow, and no
  folder, so it does not look like every other upload app in the drawer.

  Geometry is confined to the adaptive icon's safe zone: the ring's outer edge
  reaches radius 30.5 from the centre (26 + half the 9-unit stroke) and the head
  reaches 31, both inside the 33-unit circle a launcher guarantees to show.

  Colours come from values/colors.xml: a graphite tile with the mark in the
  app's warm off-white.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring: from the top, clockwise 270 degrees, ending at the left. -->
    <path
        android:strokeColor="@color/icon_foreground"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,28 A26,26 0 1 1 28,54" />

    <!-- Head: sitting in the break, on the same radius, at the upper left. -->
    <path
        android:fillColor="@color/icon_foreground"
        android:pathData="M35.61,30.11 A5.5,5.5 0 1 1 35.61,41.11 A5.5,5.5 0 1 1 35.61,30.11 Z" />
</vector>
